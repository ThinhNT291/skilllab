# Sao chép thành .env.local (không commit) rồi điền giá trị thật. Trên Vercel: Project Settings > Environment Variables.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng ở phía server. KHÔNG đặt tiền tố NEXT_PUBLIC_, KHÔNG dùng lại khóa của dự án khác.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (chấm, nhận xét, TTS) - chỉ dùng ở API route phía server
GEMINI_API_KEY=
# Tùy chọn: ghi đè mã mô hình (mặc định xem src/lib/ai/gemini.ts). Đối chiếu với ai.google.dev/gemini-api/docs/models khi có bản mới.
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
